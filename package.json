{
  "name": "english-anki",
  "version": "1.0.0",
  "private": true,
  "description": "AJATT·MCD·Antimoon 방식 영어 문장 간격반복 앱 (FSRS, 아이폰 PWA)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs dist/pwa 4173",
